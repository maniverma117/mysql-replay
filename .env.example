# Copy this file to .env and update the values before running docker compose.
# This is a template showing the configuration variables used by the service.

# MySQL target connection
MYSQL_HOST=xxx.xxx.xxx
MYSQL_PORT=3306
MYSQL_DATABASE=xxxx
MYSQL_USER=xxxxxx
MYSQL_PASSWORD=xxxx

# Loki log source
# Loki endpoint used by the fetcher thread.
LOKI_URL=http://xxx.xxxx.xxx:3100
# Loki query used to select SQL log lines from logs.
LOKI_QUERY={job="mysql-general"}
# Maximum number of entries fetched from Loki per request.
LOKI_LIMIT=5000
# How far back in time each poll should query, in hours.
LOKI_LOOKBACK_HOURS=24
# Maximum time in seconds to wait for Loki to respond.
LOKI_REQUEST_TIMEOUT=90
# Number of retry attempts for Loki failures.
LOKI_RETRY_COUNT=3
# Seconds to wait between Loki retry attempts.
LOKI_RETRY_DELAY=5
WORKERS=20

# Replay timing
MYSQL_QUERY_MAX_SECONDS=60
# Time between fetch cycles in seconds.
POLL_INTERVAL=100
# Flask / HTTP API
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
