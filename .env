# Copy this file to .env and update values before running docker compose.
# This file is the runtime configuration for the Docker container.
# Keep sensitive data like passwords out of source control.

# MySQL target connection
MYSQL_HOST=16.xxx.xxx.180
MYSQL_PORT=3306
MYSQL_DATABASE=yxxxxo
MYSQL_USER=replication_migration
MYSQL_PASSWORD=gdaxxxxxx$

# Loki log source
# Loki endpoint used by the fetcher thread.
LOKI_URL=http://52.xxx.xxx.220:3100
# Loki query used to select SQL log lines.
# Uncomment the generic query only if you want all logs.
#LOKI_QUERY={job="mysql-general"}
LOKI_QUERY='{job="mysql-general"} |~ "(?i)select"'
# Maximum number of entries fetched from Loki per request.
LOKI_LIMIT=1000
# How many hours back to query from the current time.
LOKI_LOOKBACK_HOURS=1
# Maximum time in seconds to wait for Loki to respond.
LOKI_REQUEST_TIMEOUT=180
# Number of retry attempts for Loki failures.
LOKI_RETRY_COUNT=3
# Seconds to wait between Loki retry attempts.
LOKI_RETRY_DELAY=5

# Replay timing
# Maximum execution time allowed per replay query.
MYSQL_QUERY_MAX_SECONDS=300
# Time between fetch cycles in seconds.
POLL_INTERVAL=3500
# Number of worker threads that execute replay queries.
WORKERS=20

# Flask / HTTP API
FLASK_HOST=0.0.0.0
FLASK_PORT=5000           
